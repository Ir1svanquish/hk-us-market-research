# Hong Kong report configuration. Copy to .env.hk.
REPORT_LANGUAGE=zh-CN
REPORT_RENDERER_ENABLED=true
REPORT_INTEGRITY_ENABLED=true
STOCK_LIST=
V2_HK_SYMBOLS=

# Primary HK market-data provider.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# Optional fundamentals/fallback.
TUSHARE_TOKEN=

# LLM and search.
LLM_CHANNELS=
LITELLM_MODEL=
LLM_BAI_API_KEY=
LLM_DEEPSEEK_API_KEY=
TAVILY_API_KEYS=
SERPAPI_API_KEYS=

# Optional delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
