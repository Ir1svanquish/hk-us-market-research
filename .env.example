# Shared defaults. Copy to .env and keep the real file local.
REPORT_LANGUAGE=zh-CN
REPORT_RENDERER_ENABLED=true
REPORT_INTEGRITY_ENABLED=true
USE_PROXY=false
LOG_LEVEL=INFO

# Select one or more LLM channels.
LLM_CHANNELS=
LITELLM_MODEL=
LLM_BAI_API_KEY=
LLM_DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional news/search providers.
TAVILY_API_KEYS=
SERPAPI_API_KEYS=
ANSPIRE_API_KEYS=
BRAVE_API_KEYS=

# Optional delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
