# Configure any combination of channels, then copy the required lines
# into .env.hk and/or .env.us.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# Email / SMTP
EMAIL_SENDER=
EMAIL_SENDER_NAME=Daily Stock Analysis
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
MERGE_EMAIL_NOTIFICATION=false

# WeCom / Enterprise WeChat robot
WECHAT_WEBHOOK_URL=
WECHAT_MSG_TYPE=markdown
WECHAT_MAX_BYTES=4000

# Feishu robot; app credentials additionally enable cloud-document output
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
FEISHU_WEBHOOK_KEYWORD=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=
FEISHU_MAX_BYTES=20000

# DingTalk robots are sent through the custom webhook adapter.
# Multiple URLs are comma-separated.
CUSTOM_WEBHOOK_URLS=
CUSTOM_WEBHOOK_BEARER_TOKEN=
WEBHOOK_VERIFY_SSL=true

# Discord: use either webhook mode or bot mode.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_MAIN_CHANNEL_ID=
DISCORD_MAX_WORDS=2000

# Slack: use either webhook mode or bot mode.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Mobile push services
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
SERVERCHAN3_SENDKEY=

# AstrBot HTTP endpoint
ASTRBOT_URL=
ASTRBOT_TOKEN=

# Optional: render Markdown as an image for selected channels.
# Example: telegram,wechat,custom,email
MARKDOWN_TO_IMAGE_CHANNELS=
MARKDOWN_TO_IMAGE_MAX_CHARS=12000
